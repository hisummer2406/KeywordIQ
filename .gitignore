.venv/
.idea/
.vscode/
.agents/
.codex/
.workbuddy/
plugins/
.claude/*
!.claude/settings.json
# 提交门禁与项目 skill 是团队资产（规则、流程），不是个人配置，随代码走。
# settings.local.json 仍然被忽略——那里放个人权限与本机路径。
!.claude/hooks/
!.claude/skills/
!.claude/rules/
!.claude/commands/
.claude/commands/*
!.claude/commands/deliver-pr.md
!.claude/commands/fix-review.md
!.claude/commands/close-change.md
.DS_Store
.env
logs/*
# 忽略所有__pycache__目录
__pycache__/
uploads/
# 自建 PostgreSQL 的 bind mount 数据目录（PGDATA_HOST_PATH 默认值），体量大且是二进制，
# 不应入库——数据的持久性由备份方案负责，不是靠 git。
pgdata/

# docs/ 整个不入库：里面是 PRD、报价单一类的业务文档，以及 docs/table/ 下的真实搜索词
# 报告样本。前者是二进制、改一次就在历史里留一份全量副本，且从不参与构建或测试；
# 后者是客户数据，CLAUDE.md 的 guardrail 明令禁止入库。
#
# 规格的唯一来源是 openspec/，不是这里——docs/ 只是本地放参考资料的地方。
docs/

# 忽略Python字节码文件（.pyc/.pyo/.pyd）
*.py[cod]
*$py.class
