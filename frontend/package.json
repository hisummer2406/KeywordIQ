{
  "name": "keywordiq-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "KeywordIQ 后台 SPA（Umi Max + Ant Design Pro）",
  "scripts": {
    "dev": "max dev",
    "build": "max build && max esbuildHelperChecker dist",
    "format": "prettier --write \"src/**/*.{ts,tsx,less,md,json}\"",
    "lint": "eslint src --ext .ts,.tsx",
    "tsc": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup": "max setup",
    "postinstall": "max setup"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@ant-design/pro-components": "^2.8.2",
    "@umijs/max": "^4.4.11",
    "ali-oss": "^6.22.0",
    "antd": "^6.7.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/ali-oss": "^6.16.11",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "eslint": "^8.57.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.4.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=18"
  }
}
