APP_NAME=KeywordIQ
DEBUG=False
VERSION=1.0.0
ADMIN_SECRET_KEY=change-me-in-production

# ========================================
# 数据库连接池配置
# ========================================
# 连接池大小：每个 worker 约需要 0.5-1 个连接
# 2C4G RDS 建议值: 8-12
# 4C8G RDS 建议值: 16-24
DB_POOL_SIZE=8
# 最大溢出连接数：允许超过 pool_size 的额外连接
DB_MAX_OVERFLOW=12
# 连接获取超时（秒）
DB_POOL_TIMEOUT=30
# 连接回收时间（秒）：防止 PostgreSQL 长连接闲置被断开
DB_POOL_RECYCLE=1800
# 连接预检：使用连接前先 ping 检查有效性
DB_POOL_PRE_PING=True
# SQL 日志：开发环境可开启，生产环境建议关闭
DB_ECHO=False
# 查询超时时间（秒）
DB_QUERY_TIMEOUT=30

# ========================================
# 数据库连接配置
# ========================================
# Docker 本地开发
# DATABASE_URL=postgresql://postgres:pwd123@localhost/amazon_search
# DATABASE_URL_ASYNC=postgresql+asyncpg://postgres:pwd123@localhost/amazon_search
# DATABASE_SCHEMA=analysis

# 阿里云 RDS PostgreSQL
# DATABASE_URL=postgresql://postgres:password@pgm-example-rds-host.pg.rds.aliyuncs.com/amazon_search
# DATABASE_URL_ASYNC=postgresql+asyncpg://postgres:password@pgm-example-rds-host.pg.rds.aliyuncs.com/amazon_search
# DATABASE_SCHEMA=analysis

# redis (可选，用于缓存)
# REDIS_URL=redis://localhost:6379/0

# ========================================
# 站点配置
# ========================================
# 启用的站点，逗号分隔。必须是 app/site_registry.py 的 SITE_CATALOG 中
# 已登记的 ISO 3166-1 alpha-2 站点码（英国用 GB，不是 UK）。
# 它决定哪些站点可以导入与查询，也决定事实表要维护哪些分区。
# 写错会导致启动失败，这是刻意的——总好过数据写到一个查不到的归属下。
ENABLED_SITES=US,GB,DE
# 分析查询未传站点参数时的默认站点。必须属于 ENABLED_SITES；留空则取列表首个。
DEFAULT_SITE=US
# 热窗口：库中只保留最近多少个自然月的数据，更早的月度分区由保留清理自动移出。
# 单位为月，默认 3（当前月 + 前两个月）。日报与周报统一适用同一窗口。
HOT_WINDOW_MONTHS=3

# 上传配置
UPLOAD_DIR=uploads
MAX_FILE_SIZE=3221225472

# ========================================
# 原始文件归档目录：导入成功后原始 CSV 移到这里（不删除）。
# 当前是本地目录，为将来接 OSS 预留。注意会累积占盘，接 OSS 前需清理策略。
# ========================================
IMPORT_ARCHIVE_DIR=archive/raw

# ========================================
# 对象存储（OSS）：表格文件先前端直传 OSS，再由后端凭 object key 从 OSS 拉取导入。
# 服务端凭证只在这里持有，前端只拿短时 STS 临时凭证。OSS_ENABLED=false 时走本地文件退路
# （本地开发与 CI 默认关闭，无需填其余项）。
# ========================================
OSS_ENABLED=false
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_REGION=cn-hangzhou
OSS_BUCKET=keywordiq-imports
# object key 前缀，临时凭证据此限权，防前端越权到其他前缀
OSS_KEY_PREFIX=imports
# 服务端凭证：用于签发 STS 与从 OSS 读对象（生产用 RAM 子账号，最小权限）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_STS_ENDPOINT=https://sts.aliyuncs.com
# 前端直传所扮演的 RAM 角色 ARN，如 acs:ram::123456789:role/keywordiq-uploader
OSS_STS_ROLE_ARN=
# 临时凭证有效期（秒），保持短时
OSS_STS_DURATION_SECONDS=3600

# ========================================
# 批处理配置
# 注意：V2 导入走 COPY 流式装载，不再依赖 BATCH_SIZE 逐行处理；这两项仅 V1 路径与
# 少数辅助逻辑使用。安全值：BATCH_SIZE ≤ 6000（8GiB 内存下的分块上限）、MINIBATCH_SIZE 500。
# ========================================
BATCH_SIZE=6000
#小批次提交数量
MINIBATCH_SIZE=500
#工作进程数
MAX_WORKERS=2
#多进程处理文件大小
MULTIPROCESSING_THRESHOLD_MB=100.0
# 文件分块行数
FILE_SPLIT_LINES=100000