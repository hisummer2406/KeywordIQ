APP_NAME=KeywordIQ
DEBUG=False
VERSION=1.0.0
ADMIN_SECRET_KEY=change-me-in-production

# ========================================
# 数据库连接池配置
# ========================================
# 连接池大小。
#
# database.py 在模块级创建**两个**引擎，各自持有独立的池，服务的负载性质完全不同，
# 因此分开配置。全局上限的算式是：
#
#     (DB_POOL_SIZE + DB_MAX_OVERFLOW) × workers
#   + (DB_ASYNC_POOL_SIZE + DB_ASYNC_MAX_OVERFLOW) × workers
#
# start.sh / Dockerfile 固定起 4 个 worker。
#
# 自 dockerize-selfhosted-infra 变更起，PostgreSQL 与应用同机部署（同一组 4 vCPU/
# 8 GiB，不再是独立的 RDS 实例），因此这里直接取此前记录的目标值（同步 2+3、异步 8+8，
# 全局上限 21×4=84），而不是沿用"数据库在独立机器"时期的 20/10。理由：PostgreSQL
# 进程本身现在也要在这组核心上跑，池子越大只会把"快速可见的失败（pool_timeout）"换成
# "整体缓慢劣化"，且这台机器不再有 RDS 那样独立的 2 vCPU 专用于数据库。
#
# 这不是"凭感觉调"——是新部署形态下的起点值，仍需在实现阶段用真实周报导入负载观测
# pg_stat_activity 的 active 峰值核对，见 openspec/changes/dockerize-selfhosted-infra/
# design.md 决策 5。

# 同步引擎：导入的 COPY、导出的服务端游标、Alembic 迁移。低并发长事务。
DB_POOL_SIZE=2
# 最大溢出连接数：允许超过 pool_size 的额外连接
DB_MAX_OVERFLOW=3

# 异步引擎：面向请求的查询与鉴权路径。随用户数增长的是这一条。
DB_ASYNC_POOL_SIZE=8
DB_ASYNC_MAX_OVERFLOW=8
# 连接获取超时（秒）
DB_POOL_TIMEOUT=30
# 连接回收时间（秒）：防止 PostgreSQL 长连接闲置被断开
DB_POOL_RECYCLE=1800
# 注：连接预检（pool_pre_ping）与 SQL 日志（echo）不是配置项——前者在 database.py
# 硬编码为 True（与 TCP keepalive 配套，关掉会让 worker 被半开连接挂死），
# 后者跟随 DEBUG。

# 线程池上限（每 worker）。**与连接池无关，不要跟着一起调。**
#
# 走 anyio 默认线程限流器的有三类工作，只有第一类占数据库连接：
#   1. 同步 def 端点（导出）与健康检查探活
#   2. bcrypt 哈希/校验（每次登录 ~247 ms 纯 CPU，不占连接）
#   3. 同步 BackgroundTask（导入，一条线程占住整场，可达数十分钟）
# 曾按 DB_POOL_SIZE + DB_MAX_OVERFLOW 推导，那样把同步池降到 2+3 会让它塌到 5，
# 一个导入在跑就只剩 4 条线程给全部登录。
THREAD_POOL_LIMIT=32

# ========================================
# 数据库连接配置
# ========================================
# 本地开发（宿主机直连，不经 Docker）
# DATABASE_URL=postgresql://postgres:pwd123@localhost/amazon_search
# DATABASE_URL_ASYNC=postgresql+asyncpg://postgres:pwd123@localhost/amazon_search
# DATABASE_SCHEMA=analysis

# 生产：自建 PostgreSQL（Docker Compose 同机部署，见 docker-compose.yml）
# host 是 compose 服务名 `db`，走 Docker 内部网络，不经宿主机端口。
# **这里是 docker-compose 的纯字符串变量替换，不是 URL 编码替换**：POSTGRES_PASSWORD
# 若含 `@`/`/`/`:`/`#`/`%`/`?` 等 DSN 保留字符，会被原样拼进下面两行，SQLAlchemy 解析
# 出来的 host/database 就是错的（`user:p@ss@db` 这种连 host 在哪结束都分不清），两个
# 引擎（config.py 的 DATABASE_URL/DATABASE_URL_ASYNC 都是裸 str，不做校验）会在应用启动
# 时才连接失败，而这一步发生在切换 .env 之后——离真正暴露问题隔了一步（Codex 审核
# PR #84 第五轮）。**生成密码时只用字母数字**（如 `openssl rand -hex 24`），从根上避开
# 转义问题，不要在这里手写百分号编码——那样 docker-compose 同一份变量还要再给 `db`
# 服务的 POSTGRES_PASSWORD 原样传一份未编码的明文，两份必须手动保持同步且容易漏改。
# DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@db/${POSTGRES_DB}
# DATABASE_URL_ASYNC=postgresql+asyncpg://postgres:${POSTGRES_PASSWORD}@db/${POSTGRES_DB}
# DATABASE_SCHEMA=analysis

# 历史参考：阿里云 RDS PostgreSQL（dockerize-selfhosted-infra 变更前的生产形态，
# 迁移观察窗口内作为回滚目标保留）。**只在自建库还没有任何新写入时，换回这里才是
# 无损回滚**——一旦观察窗口内有导入或用户写入落到自建库，RDS 就已经落后，配置换回来
# 会丢弃这部分写入。详见 design.md「迁移窗口数据不一致」与 Migration Plan 步骤 6。
# DATABASE_URL=postgresql://postgres:password@pgm-bp1pj6573n99v582po.pg.rds.aliyuncs.com/amazon_search
# DATABASE_URL_ASYNC=postgresql+asyncpg://postgres:password@pgm-bp1pj6573n99v582po.pg.rds.aliyuncs.com/amazon_search

# ========================================
# 自建 PostgreSQL 容器（docker-compose.yml 的 `db` 服务读取，不是 Settings 字段）
# ========================================
# 这几项是 Postgres 官方镜像的初始化环境变量与 docker-compose 变量替换用的值，
# 不经 config.py，因此不受"新增配置项必须同步 test_conventions.py 覆盖率检查"约束
# ——但仍要写在这里，否则 `docker compose up` 时这些变量取不到值。
# 改这个值必须同步改 docker/netdata/go.d/postgres.conf 里写死的库名——那份 Netdata
# 采集配置不支持 ${VAR} 替换，两处不一致时 PostgreSQL 那组监控图表会静默消失。
POSTGRES_DB=amazon_search
# 只用字母数字（如 `openssl rand -hex 24`）：这个值同时被上面 DATABASE_URL 的字符串
# 替换直接拼进 DSN，含 @ / : # % ? 等 URL 保留字符会解析出错误的 host/database。
POSTGRES_PASSWORD=change-me-in-production
# 宿主机上存放 PGDATA 的 bind mount 路径。选 bind mount 而非具名卷是为了让备份脚本、
# 磁盘监控、灾难恢复都能直接访问文件，不必先 `docker volume inspect` 找路径。
# 默认路径 `./pgdata` 已被 .dockerignore 排除在构建上下文之外；改成其他路径必须挪到
# 仓库（构建上下文）以外——否则 db 启动过一次之后再 `docker compose build app`，
# `COPY . .` 会把 PGDATA 里的数据库文件整个拷进应用镜像（体积暴涨、构建变慢，甚至因
# 文件不可读而构建失败）。
PGDATA_HOST_PATH=./pgdata

# 以下四项对应 design.md 决策 5 的"同机共享资源"核算，写进 db 服务的 command 里
# （`postgres -c shared_buffers=... -c ...`）。起点值，需按实测周报导入负载调整。
PG_MAX_CONNECTIONS=120
PG_SHARED_BUFFERS=2GB
PG_EFFECTIVE_CACHE_SIZE=4GB
PG_WORK_MEM=16MB


# ========================================
# 站点配置
# ========================================
# 启用的站点，逗号分隔。必须是 app/site_registry.py 的 SITE_CATALOG 中
# 已登记的 ISO 3166-1 alpha-2 站点码（英国用 GB，不是 UK）。
# 它决定哪些站点可以导入与查询，也决定事实表要维护哪些分区。
# 写错会导致启动失败，这是刻意的——总好过数据写到一个查不到的归属下。
ENABLED_SITES=US,GB,DE
# 分析查询未传站点参数时的默认站点。必须属于 ENABLED_SITES；留空则取列表首个。
DEFAULT_SITE=US
# 热窗口：库中只保留最近多少个自然月的数据，更早的月度分区由保留清理自动移出。
# 单位为月，默认 3（当前月 + 前两个月）。日报与周报统一适用同一窗口。
HOT_WINDOW_MONTHS=3

# 导出行数上限：单次导出最多多少行，超出直接拒绝（413）而非截断。
# 上限护的是浏览器内存（导出先取 blob 再下载）。
EXPORT_ROW_CAP=50000

# 持续增长市场（工具箱）的判定口径。命中条件是三条同时成立：窗口内每期都在榜、
# 累计净增名次 > GROWTH_MIN_RANK_GAIN、每个日环比都 ≥ GROWTH_MIN_DAILY_RATE。
# 只有日报参与，周报没有「连续 7 天」这个概念。
#
# 注意：这三个值在**日报导入收尾时**参与算定，改了不会影响已算定的期次——旧榜单仍是
# 旧口径。要让历史期次跟上，改完必须跑 scripts/backfill_growth.py 重算。
GROWTH_WINDOW_DAYS=7          # 窗口期数（含锚定日）。7 期产生 6 个日环比，不是 7 个
GROWTH_MIN_RANK_GAIN=10000    # 累计净增名次下限（不含），单位：名
GROWTH_MIN_DAILY_RATE=0.10    # 每个日环比的下限（含），0.10 = 10%

# 词库（工具箱 · 我的词库）的规模上限。超限一律 422 拒绝且整批不写，不静默截断。
# LIBRARY_MAX_ITEMS_PER_GROUP 同时是盯盘查询的规模保证（该查询由条目表驱动、
# LEFT JOIN 事实表与掉榜表），上调它就是在放大那条查询的最坏代价，改前先重测。
LIBRARY_MAX_GROUPS_PER_SITE=20   # 每用户每站点的分组数上限，单位：个
LIBRARY_MAX_ITEMS_PER_GROUP=500  # 每分组的关键词条数上限，单位：个

# 竞对监控（关注清单）的规模上限。超限一律 422 拒绝且整批不写，在预览阶段即校验，
# 不等到确认阶段才失败。
COMPETITOR_MAX_WATCH_PER_USER=3000    # 每用户的关注总数上限，单位：个
COMPETITOR_MAX_IMPORT_BATCH=5000      # 单次预览可解析的条数上限，单位：条
COMPETITOR_PREVIEW_TTL_SECONDS=600    # 导入预览结果的暂存时长，单位：秒（10 分钟）
# 采集端单次 ASIN 上报的条目数上限，单位：条。超限整批拒绝（422）不截断——
# 截断后的记录与「这家店只有这些品」在数据上完全一致，事后无法分辨。
COMPETITOR_MAX_REPORT_ITEMS=200

# 独立站（Shopify）监控的拉取参数。拉取挂在 import_queue.py 已有的轮询循环上，按站点
# 行的 last_fetch_at 认领到期站点，不新开定时器、不引入 Celery/Redis。
DTC_FETCH_INTERVAL_HOURS=24    # 同一站点两次拉取的最小间隔，单位：小时
# 翻页上限。撞上它必须判为不完整、不做下架判定——否则某站商品数超过上限时，超出的部分
# 会被安静地判成下架。实测最大的站 1241 个商品 / 5 页，离上限很远。
DTC_MAX_PAGES=40               # 单位：页（每页 250 个商品，40 页 = 一万个）
# 畅销榜只存前 N 名：第 300 名与第 800 名的差别没有信息量，存全量会让名次表膨胀 5~10 倍。
# 实测畅销榜每页 20 个商品，取前 100 名要翻 5 页。
DTC_RANK_TOP_N=100             # 单位：名
DTC_REQUEST_DELAY_MS=400       # 同一站点两次请求的最小间隔，单位：毫秒

# 上传配置
UPLOAD_DIR=uploads
MAX_FILE_SIZE=3221225472

# 排队批次接手轮询间隔（秒）。导入串行，抢不到锁的批次留在 QUEUED，由轮询任务在锁
# 释放后自动接手。设 0 关闭接手（排队批次将不会自动开始，只在排障时这么做）。
IMPORT_QUEUE_POLL_SECONDS=30

# ========================================
# 对象存储（OSS）：表格文件先前端直传 OSS，再由后端凭 object key 从 OSS 拉取导入。
# 服务端凭证只在这里持有，前端只拿短时 STS 临时凭证。OSS_ENABLED=false 时走本地文件退路
# （本地开发与 CI 默认关闭，无需填其余项）。
#
# 配好后跑 `uv run python scripts/check_oss.py` 验证整条链路（STS 签发 → 直传 → 越权被拒
# → 服务端读回 → CORS），退出码非 0 即有项未通过。
#
# ⚠️ 上线前必改（开发环境为图方便放宽了这几处，原样带到生产就是线上问题）：
#   1. bucket 的 CORS「来源」收窄到实际前端域名。开发时常配成 *，那等于允许任意网站的
#      页面借用户浏览器往你 bucket 发跨域请求。CORS 配在 bucket 上、不在本文件里，
#      check_oss.py 只校验规则是否够用，不会因为来源过宽而报错——得人工确认。
#   2. OSS_ENDPOINT 换成内网地址（oss-<region>-internal.aliyuncs.com）。后端在 ECS 上读
#      对象走内网省公网流量费；前端仍走公网，它只用 OSS_REGION 自己拼地址，不受影响。
#   3. 生产用独立 bucket 与独立 RAM 子账号，不要复用开发环境的——开发 bucket 的权限和
#      CORS 都更松。
#   4. OSS_STS_DURATION_SECONDS 可按实际最大文件的上传耗时下调，凭证有效期越短越好。
#      注：前端已接 refreshSTSToken 自动续期（ossUpload.ts），长上传不会因过期中断，
#      所以这个值可以放心取短，不必为 GB 级文件预留时间。
#   5. bucket 配一条「碎片」生命周期规则（如 7 天后删除未完成的分片上传）。分片上传
#      中途关页面会留下已上传的分片：不构成对象、在文件列表里看不见，却持续计费。
#      前端在会话内放弃时会主动 abort，页面一关就没人收了，只有这条规则兜得住。
# ========================================
OSS_ENABLED=false
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_REGION=cn-hangzhou
OSS_BUCKET=keywordiq-imports
# object key 前缀，临时凭证据此限权，防前端越权到其他前缀
OSS_KEY_PREFIX=imports
# 服务端凭证：用于签发 STS 与从 OSS 读对象（生产用 RAM 子账号，最小权限）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 前端直传所扮演的 RAM 角色 ARN，如 acs:ram::123456789:role/keywordiq-uploader
OSS_STS_ROLE_ARN=
# 临时凭证有效期（秒），保持短时。
# 注意它还决定第二件事：**直传批次多久算「不可能再传完」**。凭证一过期，后续分片一律
# 被拒，这次上传就完成不了了——所以「上传中」批次的回收阈值 = 本项 + 300 秒宽限
# （config.upload_stale_seconds，刻意不做成独立配置项，见变更 track-upload-before-import
# 的 design 决策 2）。调小本项会让中断的上传更快被判失败，但也别小于最大文件的实际上传耗时。
OSS_STS_DURATION_SECONDS=3600
# ========================================
# 钉钉单点登录（SSO）
#
# 直连钉钉开放平台的**企业内部应用**，走 OAuth2 授权码流程 + 浏览器扫码。
#
# **这套不是 OIDC，尽管授权 URL 里的 scope 叫 openid。** 钉钉换回来的是 accessToken，
# 没有 id_token、没有 JWKS、没有 discovery 端点——接不上任何 OIDC 依赖方库。而且
# /v1.0/contact/users/me 只给个人身份（unionId、nick，文档明写"无手机号和企业相关信息"），
# 要拿企业内 userid、姓名与在职状态，必须再用**企业** accessToken 调通讯录接口。
# 所以下面一组 AppKey/AppSecret 同时服务两套凭证。
#
# 另注：oapi.dingtalk.com/connect/oauth2/sns_authorize + sns/getuserinfo_bycode 那一套
# 已于 2021-12 迁入钉钉的历史文档区，不要采用。
#
# SSO_ENABLED=false 时 SSO 端点一律 404、登录页不显示钉钉按钮——本地开发与 CI 的默认状态。
# 置 true 则下面三项凭证缺一不可，缺了**启动就失败**（config.py 的 _validate_sso_credentials）：
# 一个"配了但不生效"的 SSO 开关，症状是员工扫完码回来看到说不清的错误，而配置看上去正常。
#
# 上线前：
#   1. 在钉钉开发者后台建企业内部应用，取 AppKey/AppSecret，开通讯录读取权限
#   2. 在「开发配置 > 安全设置」登记重定向 URL，必须与 SSO_REDIRECT_URI 完全一致，
#      否则扫码后回不来（提示无权限访问）
#   3. AppSecret 只存服务端，绝不能进前端产物、响应体或日志
#   4. 用 scripts/check_dingtalk_sso.py 实测整条链路——回调域名配错与真机扫码这两件事
#      无法靠 code review 确认
# ========================================
SSO_ENABLED=false
# 企业内部应用的 AppKey，同时作为授权 URL 的 client_id
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
# 指向 SPA 的 /sso/callback，如 https://your-domain.com/sso/callback
SSO_REDIRECT_URI=
# 首次扫码建档时赋予的角色码，必须存在于 role 表（启动期检查）。
# 默认 analyst：能查询导出、不能导入。**不从钉钉部门/职位映射**——那会让
# 「谁能导入数据」取决于通讯录怎么编排。
SSO_DEFAULT_ROLE_CODE=analyst
