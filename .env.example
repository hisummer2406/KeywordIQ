APP_NAME=KeywordIQ
DEBUG=False
VERSION=1.0.0
ADMIN_SECRET_KEY=change-me-in-production

# ========================================
# 数据库连接池配置
# ========================================
# database.py 建了**两个**独立引擎/池（同步/异步负载性质不同），全局连接上限：
#   (DB_POOL_SIZE + DB_MAX_OVERFLOW) × workers + (DB_ASYNC_POOL_SIZE + DB_ASYNC_MAX_OVERFLOW) × workers
# start.sh / Dockerfile 固定 4 个 worker。
#
# 自 dockerize-selfhosted-infra 起 PostgreSQL 与应用同机部署（共享 4 vCPU/8 GiB），
# 取值是这组约束下的目标值（同步 2+3、异步 8+8，全局 84），不是独立 RDS 时期的 20/10
# ——池子越大只会把"快速可见的失败"换成"整体缓慢劣化"，且这组核心现在还要跑 PostgreSQL
# 本身。仍需按真实周报导入负载核对 pg_stat_activity 峰值，见
# openspec/changes/dockerize-selfhosted-infra/design.md 决策 5。

# 同步引擎：导入的 COPY、导出的服务端游标、Alembic 迁移，低并发长事务
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=3

# 异步引擎：面向请求的查询与鉴权路径，随用户数增长的是这一条
DB_ASYNC_POOL_SIZE=8
DB_ASYNC_MAX_OVERFLOW=8
DB_POOL_TIMEOUT=30    # 连接获取超时（秒）
DB_POOL_RECYCLE=1800  # 连接回收时间（秒），防止长连接闲置被断开
# 连接预检（pool_pre_ping）与 SQL 日志（echo）不是配置项：前者在 database.py 硬编码
# True（配 TCP keepalive，识破被静默丢弃的半开连接），后者跟随 DEBUG。

# 线程池上限（每 worker）。**与连接池无关，不要跟着一起调**——走这个限流器的三类工作
# 只有同步 def 端点（导出）/健康检查占数据库连接；bcrypt（每次登录 ~247ms 纯 CPU）与
# 同步 BackgroundTask（导入，一条线程占住整场）都不占连接。曾按 DB_POOL_SIZE+
# DB_MAX_OVERFLOW 推导，同步池降到 2+3 后限流器会塌到 5，一个导入在跑就只剩 4 条线程
# 给全部登录，故两者拆开。
THREAD_POOL_LIMIT=32

# ========================================
# 数据库连接配置
# ========================================
# 本地开发（宿主机直连，不经 Docker）
# DATABASE_URL=postgresql://postgres:pwd123@localhost/amazon_search
# DATABASE_URL_ASYNC=postgresql+asyncpg://postgres:pwd123@localhost/amazon_search
# DATABASE_SCHEMA=analysis

# 生产：自建 PostgreSQL（Docker Compose 同机部署，见 docker-compose.yml），host 是
# compose 服务名 `db`。**POSTGRES_PASSWORD 只用字母数字**（如 openssl rand -hex 24）：
# 这里是纯字符串替换不是 URL 编码，密码含 @/:/#/%/? 等 DSN 保留字符会拼出错误的
# host/database，且要等应用启动连接时才失败（Codex 审核 PR #84 第五轮）。
# DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@db/${POSTGRES_DB}
# DATABASE_URL_ASYNC=postgresql+asyncpg://postgres:${POSTGRES_PASSWORD}@db/${POSTGRES_DB}
# DATABASE_SCHEMA=analysis

# 历史参考：迁移前的阿里云 RDS，仅作回滚目标保留。**只在自建库还没有新写入时换回
# 才是无损回滚**，详见 design.md「迁移窗口数据不一致」步骤 6。
# DATABASE_URL=postgresql://postgres:password@pgm-example-rds-host.pg.rds.aliyuncs.com/amazon_search
# DATABASE_URL_ASYNC=postgresql+asyncpg://postgres:password@pgm-example-rds-host.pg.rds.aliyuncs.com/amazon_search

# ========================================
# 自建 PostgreSQL 容器（docker-compose.yml 的 `db` 服务读取，不进 config.py）
# ========================================
# Postgres 官方镜像的初始化变量。改 POSTGRES_DB 要同步改
# docker/netdata/go.d/postgres.conf 里写死的库名（不支持 ${VAR}），漏改会让那组监控
# 图表静默消失。
POSTGRES_DB=amazon_search
# 只用字母数字（如 openssl rand -hex 24）：会被拼进上面的 DATABASE_URL，含 DSN 保留
# 字符会解析出错误的 host/database。
POSTGRES_PASSWORD=change-me-in-production
# PGDATA 的 bind mount 路径（非具名卷，便于备份/灾难恢复直接访问文件）。默认路径已被
# .dockerignore 排除；改成其他路径必须挪到仓库外，否则会被 `COPY . .` 整个拷进镜像。
PGDATA_HOST_PATH=./pgdata

# 同机共享资源起点值（design.md 决策 5），需按实测周报导入负载调整
PG_MAX_CONNECTIONS=120
PG_SHARED_BUFFERS=2GB
PG_EFFECTIVE_CACHE_SIZE=4GB
PG_WORK_MEM=16MB


# ========================================
# 站点配置
# ========================================
# 启用的站点，逗号分隔，须是 app/site_registry.py SITE_CATALOG 已登记的站点码
# （英国是 GB 不是 UK）。决定哪些站点可导入/查询、维护哪些分区；写错启动失败（刻意）。
ENABLED_SITES=US,GB,DE
DEFAULT_SITE=US       # 未传站点时的默认值，须属于 ENABLED_SITES，留空取列表首个
HOT_WINDOW_MONTHS=3   # 保留窗口（月），更早的月度分区由保留清理自动移出，日报周报同一窗口

EXPORT_ROW_CAP=50000  # 导出行数上限，超出直接拒绝（413）不截断——护的是浏览器内存

# 慢查询两层独立阈值（互不共用）：单条 SQL 语句慢（同步+异步引擎都记）与
# /api/analysis/search 整体调用慢的结构化诊断，见
# add-request-diagnostics-logging/design.md 决策 D
SLOW_QUERY_THRESHOLD_SECONDS=1.0       # 单位：秒
ANALYSIS_SLOW_QUERY_THRESHOLD_MS=1000  # 单位：毫秒

# 交互查询执行预算：异步引擎的 statement_timeout，超时由数据库取消语句并返回 503。
# 导入/导出走同步引擎不受影响。必须为正数（0 在 PostgreSQL 里是「不限时」）。
INTERACTIVE_STATEMENT_TIMEOUT_MS=30000  # 单位：毫秒
# 分析查询每 worker 并发上限与排队等待上限，排不上返回 503 繁忙
ANALYSIS_MAX_CONCURRENT_SEARCHES=4
ANALYSIS_SEARCH_QUEUE_TIMEOUT_SECONDS=5  # 单位：秒
# 分析查询完整请求预算（含排队）；每条语句收紧到剩余预算、到点由数据库取消，超出返回 503
ANALYSIS_REQUEST_TIMEOUT_SECONDS=25  # 单位：秒
# 异步引擎上数据库检测客户端断开的间隔：请求被取消后服务端语句在约一个间隔内停止。
# 0 关闭（取消的查询会在服务端跑到 statement_timeout）；需 PostgreSQL 14+、Linux。
INTERACTIVE_CLIENT_CHECK_INTERVAL_MS=1000  # 单位：毫秒
# 分析查询在客户端断开时取消；false 时断开的查询跑到完整请求预算为止
ANALYSIS_CANCEL_ON_DISCONNECT_ENABLED=true

# 持续增长市场判定口径：窗口内每期都在榜 + 累计净增名次 > GROWTH_MIN_RANK_GAIN +
# 每个日环比 ≥ GROWTH_MIN_DAILY_RATE，只有日报参与。**在导入收尾时算定，改值不影响
# 已算定期次**，要让历史跟上必须跑 scripts/backfill_growth.py 重算。
GROWTH_WINDOW_DAYS=7          # 窗口期数（含锚定日），7 期产生 6 个日环比
GROWTH_MIN_RANK_GAIN=10000    # 累计净增名次下限（不含），单位：名
GROWTH_MIN_DAILY_RATE=0.10    # 每个日环比下限（含），0.10 = 10%

# 词库规模上限，超限一律 422 拒绝且整批不写。LIBRARY_MAX_ITEMS_PER_GROUP 同时是盯盘
# 查询（LEFT JOIN 事实表与掉榜表）的规模保证，上调前先重测。
LIBRARY_MAX_GROUPS_PER_SITE=20   # 每用户每站点分组数上限，单位：个
LIBRARY_MAX_ITEMS_PER_GROUP=500  # 每分组条目数上限，单位：个

# 竞对监控（关注清单）规模上限，超限一律 422 拒绝且整批不写，在预览阶段即校验
COMPETITOR_MAX_WATCH_PER_USER=3000    # 每用户关注总数上限，单位：个
COMPETITOR_MAX_IMPORT_BATCH=5000      # 单次预览可解析条数上限，单位：条
COMPETITOR_PREVIEW_TTL_SECONDS=600    # 导入预览暂存时长，单位：秒（10 分钟）
# 采集端单次 ASIN 上报条目数上限，超限整批拒绝（422）不截断——截断后的记录与
# 「这家店只有这些品」在数据上完全一致，事后无法分辨。插件从 /api/competitor/collector-config
# 读取，改这里后无需重发插件。
COMPETITOR_MAX_REPORT_ITEMS=1000     # 单位：条
# 采集端页面选择器覆盖（JSON 文件路径，格式见 openspec 变更 extension-remote-selectors）。
# 插件自动采集每轮开始时读取，改文件后无需重启、无需重装插件；留空表示用插件内置选择器。
COMPETITOR_COLLECTOR_SELECTORS_FILE=

# 独立站（Shopify）监控拉取参数。拉取挂在 import_queue.py 已有的轮询循环上，按站点
# last_fetch_at 认领到期站点，不新开定时器、不引入 Celery/Redis。
DTC_FETCH_INTERVAL_HOURS=24    # 同一站点两次拉取的最小间隔，单位：小时
# 翻页上限，撞上必须判为不完整、不做下架判定——否则超出上限的部分会被安静判成下架。
# 实测最大的站 1241 个商品/5 页，离上限很远。
DTC_MAX_PAGES=40               # 单位：页（每页 250 个商品）
DTC_RANK_TOP_N=100             # 畅销榜只存前 N 名（300 名与 800 名的差别没有信息量），单位：名
# 同一站点两次请求的最小间隔。400 时生产大面积被 Shopify 限流（429），2000 实测可连续翻页。
DTC_REQUEST_DELAY_MS=2000      # 单位：毫秒

# 上传配置
UPLOAD_DIR=uploads
MAX_FILE_SIZE=3221225472

# 排队批次接手轮询间隔（秒）。导入串行，抢不到锁的批次留在 QUEUED 等轮询接手；
# 设 0 关闭自动接手（仅排障用）。
IMPORT_QUEUE_POLL_SECONDS=30

# 外观专利核查（智慧芽 Data REST API，#24）。Key 在智慧芽管理后台 → API 密钥创建，只写在
# 服务端 .env，不提交、不进前端。留空 = 未配置：页面提示联系管理员，不发起任何外部调用。
ZHIHUIYA_API_KEY=
RISK_TASK_POLL_SECONDS=3          # 核查任务轮询间隔，单位：秒；0 关闭
RISK_TASK_LEASE_SECONDS=180       # 任务租约，单位：秒；超时转「结果未知」，不自动重发
RISK_PROVIDER_TIMEOUT_SECONDS=30  # 单次智慧芽调用超时，单位：秒
RISK_EVIDENCE_OSS_PREFIX=risk-evidence  # 全部附图与公报 PDF 存档的 OSS key 前缀；复用下方 OSS_* 配置，OSS 未启用时只留签名链接
# 机会中心 IP 专家 Agent（#180）：智慧芽专利数据库 MCP 共用上面的 ZHIHUIYA_API_KEY。
OPPORTUNITY_IP_MCP_BUDGET_PER_RESEARCH=20  # 单次调研最多 MCP 调用次数（含失败与未知）
OPPORTUNITY_IP_MCP_DAILY_LIMIT=200         # 全站每天（北京时间）最多 MCP 调用次数
OPPORTUNITY_IP_TASK_POLL_SECONDS=3         # 任务轮询间隔，单位：秒；0 关闭
OPPORTUNITY_IP_TASK_LEASE_SECONDS=900      # 任务租约，单位：秒；超时转「结果未知」，不自动重发
OPPORTUNITY_IP_MCP_TIMEOUT_SECONDS=30      # 单次 MCP 调用超时，单位：秒
# 大模型（OpenAI 兼容协议，如 DeepSeek https://api.deepseek.com、通义
# https://dashscope.aliyuncs.com/compatible-mode/v1）。任一为空 = 未配置，Agent 生成与分析不可用。
OPPORTUNITY_LLM_BASE_URL=
OPPORTUNITY_LLM_API_KEY=
OPPORTUNITY_LLM_MODEL=
OPPORTUNITY_LLM_TIMEOUT_SECONDS=120        # 单次大模型调用超时，单位：秒
# 导入后刷新查询统计（ANALYZE 写入的叶子分区）的执行上限；超时不回滚，轮询空闲时重试
IMPORT_ANALYZE_TIMEOUT_SECONDS=300  # 单位：秒

# ========================================
# 对象存储（OSS）：表格文件先前端直传 OSS，再由后端凭 object key 从 OSS 拉取导入。
# 服务端凭证只在这里持有，前端只拿短时 STS 临时凭证。OSS_ENABLED=false 时走本地文件
# 退路（本地开发与 CI 默认关闭，无需填其余项）。配好后跑
# `uv run python scripts/check_oss.py` 验证整条链路（STS 签发 → 直传 → 越权被拒 →
# 服务端读回 → CORS），退出码非 0 即有项未通过。
#
# ⚠️ 上线前必改（开发环境为图方便放宽了这几处，原样带到生产就是线上问题）：
#   1. bucket 的 CORS「来源」收窄到实际前端域名（开发时常配成 *；check_oss.py 只校验
#      规则是否够用，不会因来源过宽而报错，得人工确认）
#   2. OSS_ENDPOINT 换成内网地址（oss-<region>-internal.aliyuncs.com），后端在 ECS 上
#      读对象省公网流量费；前端仍走公网，不受影响
#   3. 生产用独立 bucket 与独立 RAM 子账号，不复用开发环境的（权限和 CORS 都更松）
#   4. OSS_STS_DURATION_SECONDS 可按实际最大文件上传耗时下调——前端已有自动续期
#      （ossUpload.ts），长上传不会因过期中断，不必为 GB 级文件预留时间
#   5. bucket 配一条「碎片」生命周期规则（如 7 天后删除未完成的分片上传）：中途关页
#      面会留下已上传的分片，不构成对象、看不见却持续计费，前端的主动 abort 只在会话
#      内有效
# ========================================
OSS_ENABLED=false
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_REGION=cn-hangzhou
OSS_BUCKET=keywordiq-imports
OSS_KEY_PREFIX=imports          # object key 前缀，临时凭证据此限权，防前端越权到其他前缀
OSS_ACCESS_KEY_ID=              # 服务端凭证：签发 STS + 读对象（生产用最小权限 RAM 子账号）
OSS_ACCESS_KEY_SECRET=
OSS_STS_ROLE_ARN=               # 前端直传所扮演的 RAM 角色 ARN，如 acs:ram::123456789:role/keywordiq-uploader
# 临时凭证有效期（秒），保持短时。同时决定「上传中」批次的回收阈值 = 本项 + 300 秒
# 宽限（config.upload_stale_seconds，刻意不做成独立配置项，见 track-upload-before-import
# design 决策 2）——凭证一过期后续分片一律被拒，调小本项会更快判定中断的上传失败，
# 但别小于最大文件的实际上传耗时。
OSS_STS_DURATION_SECONDS=3600
# ========================================
# 钉钉单点登录（SSO）：直连钉钉开放平台的**企业内部应用**，OAuth2 授权码流程 +
# 浏览器扫码。
#
# **这套不是 OIDC**，尽管授权 URL 里的 scope 叫 openid——钉钉换回来的是 accessToken，
# 没有 id_token/JWKS/discovery，接不上任何 OIDC 依赖方库。个人身份接口
# （/v1.0/contact/users/me）只给 unionId/nick，企业内 userid/姓名/在职状态要另用
# **企业** accessToken 调通讯录接口，下面同一组 AppKey/AppSecret 服务这两套凭证。
# （历史上的 oauth2/sns_authorize 那一套已于 2021-12 迁入历史文档区，不要采用）
#
# SSO_ENABLED=false 时 SSO 端点一律 404、登录页不显示钉钉按钮（本地开发与 CI 默认）。
# 置 true 则下面三项凭证缺一不可，缺了**启动就失败**（config.py 的
# _validate_sso_credentials）——避免"配了但不生效"，员工扫码后看到说不清的错误而
# 配置看上去正常。
#
# 上线前：
#   1. 钉钉开发者后台建企业内部应用，取 AppKey/AppSecret，开通讯录读取权限
#   2.「开发配置 > 安全设置」登记的重定向 URL 须与 SSO_REDIRECT_URI 完全一致，否则
#      扫码后回不来（提示无权限访问）
#   3. AppSecret 只存服务端，绝不能进前端产物、响应体或日志
#   4. 用 scripts/check_dingtalk_sso.py 实测整条链路——回调域名配错与真机扫码这两件
#      事无法靠 code review 确认
# ========================================
SSO_ENABLED=false
DINGTALK_APP_KEY=              # 企业内部应用的 AppKey，同时作为授权 URL 的 client_id
DINGTALK_APP_SECRET=
SSO_REDIRECT_URI=              # 指向 SPA 的 /sso/callback，如 https://your-domain.com/sso/callback
# 首次扫码建档时赋予的角色码，必须存在于 role 表（启动期检查）。默认 analyst：能查询
# 导出、不能导入。**不从钉钉部门/职位映射**——那会让「谁能导入数据」取决于通讯录怎么编排。
SSO_DEFAULT_ROLE_CODE=analyst
# ========================================
# 飞书运维机器人（ops-bot）：与 app 完全独立的进程，host 级 systemd 服务
# （etc/keywordiq-ops-bot.service），不是 docker-compose 服务——受限执行器要跑的
# docker compose/nginx reload/deploy.sh 都是宿主机操作，容器化会陷入路径映射难题
# （design.md D1）。本节配置只被 ops-bot 读取，app 进程不使用。
#
# 数据库：ops-bot 用独立数据库角色 ops_bot_role，经 db 服务新增的 127.0.0.1:5432
# 端口映射连接同一个自建 PostgreSQL 容器（host 进程不在 compose 内部网络里，够不到
# `db` 这个服务名）。该角色对新开的 ops schema 有完整权限，对
# analysis.import_batch/site_data_stats 仅只读，对其余业务表没有任何权限——被攻破
# 不等于拿到业务写权限。OPS_DB_ROLE_PASSWORD 由迁移**执行那一刻**读取并 (re)set 到这个
# 角色（库已在 head 时再跑 upgrade 是空操作，不会重设），需与下面两个连接串里的密码
# 一致；本地开发可用默认值，生产必须改。密码里别放 : @ / 这类会破坏连接串的字符；连接串里可写 ${OPS_DB_ROLE_PASSWORD} 引用它。
OPS_DATABASE_URL=postgresql://ops_bot_role:change-me-in-production@localhost:5432/amazon_search
OPS_DATABASE_URL_ASYNC=postgresql+asyncpg://ops_bot_role:change-me-in-production@localhost:5432/amazon_search
OPS_DB_ROLE_PASSWORD=change-me-in-production

# 飞书企业自建应用凭证。在飞书开放平台创建自建应用、开通机器人能力与消息卡片，事件
# 订阅回调地址填 https://<域名>/ops/feishu/webhook（host nginx 反代到 ops-bot）。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=      # 校验事件订阅回调确实来自飞书（飞书开放平台「事件订阅」页可见）
FEISHU_ENCRYPT_KEY=             # 事件订阅启用加密时使用，未启用可留空
# 唯一授权操作人的飞书 open_id（ou_ 前缀）。只有这个人发出的指令/确认会被受理，不认
# 昵称、不认群管理员身份、不认"群里只有一个人"。
FEISHU_OWNER_OPEN_ID=
FEISHU_OPS_CHAT_ID=             # 通知与交互入口的 chat_id（oc_ 前缀）：运维群，或单人运维时与机器人的单聊；机器人必须在该会话内

# 巡检/告警/备份阈值。导入耗时阈值是"先观测后设阈"的保守初始值，部署后应按
# ops_import_baseline 表记录的真实导入耗时校准（design.md D3）。
OPS_ALERT_SILENCE_MINUTES=30
OPS_IMPORT_DAY_TIMEOUT_MINUTES=60
OPS_IMPORT_WEEK_TIMEOUT_MINUTES=240
OPS_ERROR_RATE_THRESHOLD=20
OPS_BACKUP_RETENTION_DAYS=30
OPS_RETENTION_MODE=off   # 定时保留清理：off 不运行 / dry_run 只预览 / execute 真实移出超期分区（不可恢复，须确认 OSS 归档后开启）
OPS_APP_BASE_URL=http://127.0.0.1:8001   # ops-bot 探测 app 的本机地址；V2 是 8001，8000 是同机 V1

# 重启/发布确认流程。GH_TOKEN 最小权限 checks:read + contents:read，发布前核实目标
# SHA 的必需 CI（backend/frontend/extension 三个 job）是否全部成功；未配置时发布路径
# 直接拒绝，不放行。
GH_TOKEN=
GH_REPO=hisummer2406/KeywordIQ
OPS_CONFIRM_TTL_MINUTES=10
OPS_MAINTENANCE_WINDOW_MINUTES=5
# ========================================
