APP_NAME=KeywordIQ
DEBUG=False
VERSION=1.0.0
ADMIN_SECRET_KEY=change-me-in-production

# ========================================
# 数据库连接池配置
# ========================================
# 连接池大小。
#
# database.py 在模块级创建**两个**引擎，各自持有独立的池，服务的负载性质完全不同，
# 因此分开配置。全局上限的算式是：
#
#     (DB_POOL_SIZE + DB_MAX_OVERFLOW) × workers
#   + (DB_ASYNC_POOL_SIZE + DB_ASYNC_MAX_OVERFLOW) × workers
#
# start.sh 固定起 4 个 worker。当前取值 (20+10)×4 + (20+10)×4 = 240 条，对 RDS 的
# max_connections=400 而言已占六成，还需为 RDS 管理连接与人工 psql 留余量。
#
# 注意 RDS 是 2 vCPU：PostgreSQL 同时真正能执行的查询受核心数限制（约 4 个），
# 池开大不会提升吞吐，只会把「快速可见的失败（pool_timeout）」换成「整体缓慢劣化」。
# 目标取值是同步 2+3、异步 8+8（全局上限 84），但降池是行为改变，应先观测
# pg_stat_activity 的 active 峰值再落，不要凭感觉调。

# 同步引擎：导入的 COPY、导出的服务端游标、Alembic 迁移。低并发长事务。
DB_POOL_SIZE=20
# 最大溢出连接数：允许超过 pool_size 的额外连接
DB_MAX_OVERFLOW=10

# 异步引擎：面向请求的查询与鉴权路径。随用户数增长的是这一条。
DB_ASYNC_POOL_SIZE=20
DB_ASYNC_MAX_OVERFLOW=10
# 连接获取超时（秒）
DB_POOL_TIMEOUT=30
# 连接回收时间（秒）：防止 PostgreSQL 长连接闲置被断开
DB_POOL_RECYCLE=1800
# 注：连接预检（pool_pre_ping）与 SQL 日志（echo）不是配置项——前者在 database.py
# 硬编码为 True（与 TCP keepalive 配套，关掉会让 worker 被半开连接挂死），
# 后者跟随 DEBUG。

# 线程池上限（每 worker）。**与连接池无关，不要跟着一起调。**
#
# 走 anyio 默认线程限流器的有三类工作，只有第一类占数据库连接：
#   1. 同步 def 端点（导出）与健康检查探活
#   2. bcrypt 哈希/校验（每次登录 ~247 ms 纯 CPU，不占连接）
#   3. 同步 BackgroundTask（导入，一条线程占住整场，可达数十分钟）
# 曾按 DB_POOL_SIZE + DB_MAX_OVERFLOW 推导，那样把同步池降到 2+3 会让它塌到 5，
# 一个导入在跑就只剩 4 条线程给全部登录。
THREAD_POOL_LIMIT=32

# ========================================
# 数据库连接配置
# ========================================
# Docker 本地开发
# DATABASE_URL=postgresql://postgres:pwd123@localhost/amazon_search
# DATABASE_URL_ASYNC=postgresql+asyncpg://postgres:pwd123@localhost/amazon_search
# DATABASE_SCHEMA=analysis

# 阿里云 RDS PostgreSQL
# DATABASE_URL=postgresql://postgres:password@pgm-bp1pj6573n99v582po.pg.rds.aliyuncs.com/amazon_search
# DATABASE_URL_ASYNC=postgresql+asyncpg://postgres:password@pgm-bp1pj6573n99v582po.pg.rds.aliyuncs.com/amazon_search
# DATABASE_SCHEMA=analysis


# ========================================
# 站点配置
# ========================================
# 启用的站点，逗号分隔。必须是 app/site_registry.py 的 SITE_CATALOG 中
# 已登记的 ISO 3166-1 alpha-2 站点码（英国用 GB，不是 UK）。
# 它决定哪些站点可以导入与查询，也决定事实表要维护哪些分区。
# 写错会导致启动失败，这是刻意的——总好过数据写到一个查不到的归属下。
ENABLED_SITES=US,GB,DE
# 分析查询未传站点参数时的默认站点。必须属于 ENABLED_SITES；留空则取列表首个。
DEFAULT_SITE=US
# 热窗口：库中只保留最近多少个自然月的数据，更早的月度分区由保留清理自动移出。
# 单位为月，默认 3（当前月 + 前两个月）。日报与周报统一适用同一窗口。
HOT_WINDOW_MONTHS=3

# 导出行数上限：单次导出最多多少行，超出直接拒绝（413）而非截断。
# 上限护的是浏览器内存（导出先取 blob 再下载）。
EXPORT_ROW_CAP=50000

# 持续增长市场（工具箱）的判定口径。命中条件是三条同时成立：窗口内每期都在榜、
# 累计净增名次 > GROWTH_MIN_RANK_GAIN、每个日环比都 ≥ GROWTH_MIN_DAILY_RATE。
# 只有日报参与，周报没有「连续 7 天」这个概念。
#
# 注意：这三个值在**日报导入收尾时**参与算定，改了不会影响已算定的期次——旧榜单仍是
# 旧口径。要让历史期次跟上，改完必须跑 scripts/backfill_growth.py 重算。
GROWTH_WINDOW_DAYS=7          # 窗口期数（含锚定日）。7 期产生 6 个日环比，不是 7 个
GROWTH_MIN_RANK_GAIN=10000    # 累计净增名次下限（不含），单位：名
GROWTH_MIN_DAILY_RATE=0.10    # 每个日环比的下限（含），0.10 = 10%

# 词库（工具箱 · 我的词库）的规模上限。超限一律 422 拒绝且整批不写，不静默截断。
# LIBRARY_MAX_ITEMS_PER_GROUP 同时是盯盘查询的规模保证（该查询由条目表驱动、
# LEFT JOIN 事实表与掉榜表），上调它就是在放大那条查询的最坏代价，改前先重测。
LIBRARY_MAX_GROUPS_PER_SITE=20   # 每用户每站点的分组数上限，单位：个
LIBRARY_MAX_ITEMS_PER_GROUP=500  # 每分组的关键词条数上限，单位：个

# 上传配置
UPLOAD_DIR=uploads
MAX_FILE_SIZE=3221225472

# 排队批次接手轮询间隔（秒）。导入串行，抢不到锁的批次留在 QUEUED，由轮询任务在锁
# 释放后自动接手。设 0 关闭接手（排队批次将不会自动开始，只在排障时这么做）。
IMPORT_QUEUE_POLL_SECONDS=30

# ========================================
# 对象存储（OSS）：表格文件先前端直传 OSS，再由后端凭 object key 从 OSS 拉取导入。
# 服务端凭证只在这里持有，前端只拿短时 STS 临时凭证。OSS_ENABLED=false 时走本地文件退路
# （本地开发与 CI 默认关闭，无需填其余项）。
#
# 配好后跑 `uv run python scripts/check_oss.py` 验证整条链路（STS 签发 → 直传 → 越权被拒
# → 服务端读回 → CORS），退出码非 0 即有项未通过。
#
# ⚠️ 上线前必改（开发环境为图方便放宽了这几处，原样带到生产就是线上问题）：
#   1. bucket 的 CORS「来源」收窄到实际前端域名。开发时常配成 *，那等于允许任意网站的
#      页面借用户浏览器往你 bucket 发跨域请求。CORS 配在 bucket 上、不在本文件里，
#      check_oss.py 只校验规则是否够用，不会因为来源过宽而报错——得人工确认。
#   2. OSS_ENDPOINT 换成内网地址（oss-<region>-internal.aliyuncs.com）。后端在 ECS 上读
#      对象走内网省公网流量费；前端仍走公网，它只用 OSS_REGION 自己拼地址，不受影响。
#   3. 生产用独立 bucket 与独立 RAM 子账号，不要复用开发环境的——开发 bucket 的权限和
#      CORS 都更松。
#   4. OSS_STS_DURATION_SECONDS 可按实际最大文件的上传耗时下调，凭证有效期越短越好。
#      注：前端已接 refreshSTSToken 自动续期（ossUpload.ts），长上传不会因过期中断，
#      所以这个值可以放心取短，不必为 GB 级文件预留时间。
#   5. bucket 配一条「碎片」生命周期规则（如 7 天后删除未完成的分片上传）。分片上传
#      中途关页面会留下已上传的分片：不构成对象、在文件列表里看不见，却持续计费。
#      前端在会话内放弃时会主动 abort，页面一关就没人收了，只有这条规则兜得住。
# ========================================
OSS_ENABLED=false
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_REGION=cn-hangzhou
OSS_BUCKET=keywordiq-imports
# object key 前缀，临时凭证据此限权，防前端越权到其他前缀
OSS_KEY_PREFIX=imports
# 服务端凭证：用于签发 STS 与从 OSS 读对象（生产用 RAM 子账号，最小权限）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 前端直传所扮演的 RAM 角色 ARN，如 acs:ram::123456789:role/keywordiq-uploader
OSS_STS_ROLE_ARN=
# 临时凭证有效期（秒），保持短时。
# 注意它还决定第二件事：**直传批次多久算「不可能再传完」**。凭证一过期，后续分片一律
# 被拒，这次上传就完成不了了——所以「上传中」批次的回收阈值 = 本项 + 300 秒宽限
# （config.upload_stale_seconds，刻意不做成独立配置项，见变更 track-upload-before-import
# 的 design 决策 2）。调小本项会让中断的上传更快被判失败，但也别小于最大文件的实际上传耗时。
OSS_STS_DURATION_SECONDS=3600